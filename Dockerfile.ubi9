# RHEL UBI9-based Dockerfile for Superset MCP Server
# This image is designed for OpenShift deployment with proper security context support

FROM registry.redhat.io/ubi9/python-311:latest

USER 0

# Set working directory
WORKDIR /opt/app-root/src

# Copy project files
COPY --chown=1001:0 . /opt/app-root/src/

# Install Python dependencies
# Using pip with --user flag for OpenShift compatibility
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir .

# Copy start script
COPY --chown=1001:0 start.sh /opt/app-root/src/start.sh

# Make start script executable
RUN chmod +x /opt/app-root/src/start.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/opt/app-root/src \
    ACCESS_TOKEN_STORE_PATH=/opt/app-root/src/.superset_cache/.superset_token

# Use non-root user (OpenShift compatible - arbitrary UID in 1001+ range)
USER 1001

# Expose port for HTTP/SSE transport (required for LibreChat)
EXPOSE 3001

CMD ["/opt/app-root/src/start.sh"]
